</style>

<script>
  // Filter jurisdictions by region
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.jur-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const cardRegion = card.getAttribute('data-region');
        if (filter === 'all' || cardRegion === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // SVG Map click to highlight card
  const mapPolys = document.querySelectorAll('.country-poly');
  mapPolys.forEach(poly => {
    poly.addEventListener('click', () => {
      const code = poly.getAttribute('data-country');
      if (!code) return;

      const targetCard = document.getElementById(`card-${code}`);
      if (targetCard) {
        // Reset filters so it is visible
        cards.forEach(c => (c as HTMLElement).style.display = 'flex');
        filterBtns.forEach(b => b.classList.remove('active'));
        document.querySelector('.filter-btn[data-filter="all"]')?.classList.add('active');

        // Scroll to card
        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // Flash highlight animation
        cards.forEach(c => c.classList.remove('highlighted'));
        targetCard.classList.add('highlighted');
        setTimeout(() => {
          targetCard.classList.remove('highlighted');
        }, 3000);
      }
    });
  });
</script>

