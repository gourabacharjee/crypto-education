---
// Ticker.astro — Real-time live cryptocurrency market ticker with auto-refresh
---

<div class="ticker" role="region" aria-label="Live cryptocurrency prices">
  <div class="ticker-container">
    <div class="ticker-badge" title="Auto-refreshing live prices">
      <span class="ticker-pulse"></span>
      <span class="ticker-badge-text">LIVE</span>
      <span class="ticker-time" id="ticker-time"></span>
    </div>

    <div class="ticker-viewport">
      <div class="ticker-track" id="ticker-track">
        <span class="ticker-loading">Loading live prices...</span>
      </div>
    </div>
  </div>
</div>

<style>
  .ticker {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
    padding: 0.45rem 0;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
  }

  .ticker-container {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  .ticker-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.75rem;
    margin-left: 1rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    z-index: 2;
  }

  .ticker-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fb950;
    box-shadow: 0 0 0 0 rgba(63, 185, 80, 0.7);
    animation: pulse-green 2s infinite;
  }

  @keyframes pulse-green {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(63, 185, 80, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(63, 185, 80, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(63, 185, 80, 0);
    }
  }

  .ticker-badge-text {
    color: var(--accent-secondary);
  }

  .ticker-time {
    color: var(--text-tertiary);
    font-size: 0.65rem;
  }

  .ticker-viewport {
    overflow: hidden;
    flex-grow: 1;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 20px, black 95%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 20px, black 95%, transparent);
  }

  .ticker-track {
    display: flex;
    gap: 2.25rem;
    white-space: nowrap;
    animation: scroll 45s linear infinite;
    width: max-content;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    transition: opacity 0.3s ease;
  }

  .ticker-symbol {
    font-weight: 700;
    color: var(--text-primary);
  }

  .ticker-price {
    color: var(--text-primary);
    font-weight: 600;
  }

  .ticker-change {
    font-weight: 600;
  }

  .ticker-change.up {
    color: var(--accent-secondary);
  }

  .ticker-change.down {
    color: var(--danger-border);
  }

  .ticker-loading {
    color: var(--text-tertiary);
    padding: 0 1rem;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 640px) {
    .ticker-time { display: none; }
    .ticker-badge { margin-left: 0.5rem; padding: 0.15rem 0.5rem; }
  }

  @media print {
    .ticker { display: none; }
  }
</style>

<script>
  // High quality initial baselines for immediate zero-latency render
  const initialCoins = [
    { symbol: 'BTC', name: 'Bitcoin', price: 96800, change: 2.3 },
    { symbol: 'ETH', name: 'Ethereum', price: 3640, change: 1.6 },
    { symbol: 'SOL', name: 'Solana', price: 182, change: 4.1 },
    { symbol: 'BNB', name: 'BNB', price: 642, change: 0.8 },
    { symbol: 'XRP', name: 'XRP', price: 0.65, change: 1.4 },
    { symbol: 'DOGE', name: 'Dogecoin', price: 0.175, change: 5.2 },
    { symbol: 'ADA', name: 'Cardano', price: 0.59, change: -0.7 },
    { symbol: 'AVAX', name: 'Avalanche', price: 41.8, change: 2.9 },
    { symbol: 'LINK', name: 'Chainlink', price: 18.9, change: 1.7 },
    { symbol: 'DOT', name: 'Polkadot', price: 8.35, change: -0.4 }
  ];

  function formatPrice(val: number): string {
    if (val >= 1000) {
      return `$${val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    } else if (val >= 1) {
      return `$${val.toFixed(2)}`;
    } else {
      return `$${val.toFixed(4)}`;
    }
  }

  function renderTicker(coins: Array<{ symbol: string; price: number; change: number }>) {
    const track = document.getElementById('ticker-track');
    const timeEl = document.getElementById('ticker-time');
    if (!track) return;

    const items = coins.map(coin => {
      const isUp = coin.change >= 0;
      const changeClass = isUp ? 'up' : 'down';
      const changePrefix = isUp ? '+' : '';
      return `<span class="ticker-item">
        <span class="ticker-symbol">${coin.symbol}</span>
        <span class="ticker-price">${formatPrice(coin.price)}</span>
        <span class="ticker-change ${changeClass}">${changePrefix}${coin.change.toFixed(1)}%</span>
      </span>`;
    }).join('');

    // Duplicate once for seamless infinite loop
    track.innerHTML = items + items;

    if (timeEl) {
      const now = new Date();
      timeEl.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
  }

  // Multi-source live fetcher (Binance primary with CoinGecko fallback)
  async function fetchLivePrices(): Promise<Array<{ symbol: string; price: number; change: number }> | null> {
    // 1. Try Binance (CORS allowed, real-time 24hr ticker)
    try {
      const pairs = [
        { sym: 'BTC', pair: 'BTCUSDT' },
        { sym: 'ETH', pair: 'ETHUSDT' },
        { sym: 'SOL', pair: 'SOLUSDT' },
        { sym: 'BNB', pair: 'BNBUSDT' },
        { sym: 'XRP', pair: 'XRPUSDT' },
        { sym: 'DOGE', pair: 'DOGEUSDT' },
        { sym: 'ADA', pair: 'ADAUSDT' },
        { sym: 'AVAX', pair: 'AVAXUSDT' },
        { sym: 'LINK', pair: 'LINKUSDT' },
        { sym: 'DOT', pair: 'DOTUSDT' }
      ];
      const symbolsParam = JSON.stringify(pairs.map(p => p.pair));
      const res = await fetch(`https://api.binance.com/api/v3/ticker/24hr?symbols=${encodeURIComponent(symbolsParam)}`, {
        signal: AbortSignal.timeout(4000)
      });
      if (res.ok) {
        const raw = await res.json();
        return pairs.map(p => {
          const match = raw.find((r: any) => r.symbol === p.pair);
          return {
            symbol: p.sym,
            price: match ? parseFloat(match.lastPrice) : 0,
            change: match ? parseFloat(match.priceChangePercent) : 0
          };
        }).filter(c => c.price > 0);
      }
    } catch {
      // Continue to fallback
    }

    // 2. Try CoinGecko as fallback
    try {
      const res = await fetch(
        'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=10&page=1&sparkline=false&price_change_percentage=24h',
        { signal: AbortSignal.timeout(4000) }
      );
      if (res.ok) {
        const raw = await res.json();
        return raw.map((c: any) => ({
          symbol: c.symbol.toUpperCase(),
          price: c.current_price,
          change: c.price_change_percentage_24h || 0
        }));
      }
    } catch {
      // Return null to keep current prices
    }

    return null;
  }

  async function updateCycle() {
    const live = await fetchLivePrices();
    if (live && live.length > 0) {
      renderTicker(live);
    }
  }

  // 1. Immediate initial render
  renderTicker(initialCoins);

  // 2. Immediate async fetch on page load
  updateCycle();

  // 3. Continuous live update every 20 seconds
  setInterval(updateCycle, 20000);
</script>
